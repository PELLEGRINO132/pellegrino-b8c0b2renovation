<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Réalisations — Pellegrino Rénovation</title>
<meta name="description" content="Réalisations de Pellegrino Rénovation : plâtrerie, corniches et moulures, restauration, mortier de chaux, carrelage et enduit plâtre traditionnel dans le Gers.">
<style>
:root{
  --bg:#f4eddf; --paper:#fffdf7; --ink:#292a2c; --muted:#6d6a62;
  --accent:#c76232; --line:#ddd3c0; --band:#ebe0c8;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.55}
a{color:inherit;text-decoration:none}
.wrap{width:min(1120px,calc(100% - 48px));margin:auto}
header{position:sticky;top:0;z-index:10;background:rgba(244,237,223,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.logo{font-family:Georgia,serif;font-weight:700;font-size:21px}
.logo small{font:700 9px Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-left:5px}
nav{display:flex;align-items:center;gap:24px;font-size:13px}
nav a:hover{color:var(--accent)}
.cta{background:var(--accent);color:#fff;padding:11px 15px;font-weight:700}
.hero{padding:82px 0 70px;background:var(--band);border-bottom:1px solid var(--line)}
.eyebrow{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#9a795c;font-weight:700;margin-bottom:10px}
h1,h2{font-family:Georgia,"Times New Roman",serif;line-height:1.02;margin:0}
h1{font-size:clamp(40px,6vw,72px);max-width:760px}
.hero p{max-width:670px;color:var(--muted);font-size:16px;margin:22px 0 0}
.intro{padding:58px 0 18px}
.intro h2{font-size:34px}
.intro p{color:var(--muted);max-width:700px}
.project{padding:72px 0;border-top:1px solid var(--line)}
.project-head{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:end;margin-bottom:28px}
.project h2{font-size:34px}
.project p{color:var(--muted);max-width:560px;margin:12px 0 0}
.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.photo{margin:0;background:var(--paper);border:1px solid var(--line);box-shadow:0 10px 24px rgba(42,35,24,.07)}
.photo:first-child{grid-column:span 2;grid-row:span 2}
.photo img{display:block;width:100%;height:220px;object-fit:cover;background:#eee7d9}
.photo:first-child img{height:454px}
.photo figcaption{padding:10px 11px;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.press{padding:72px 0;background:var(--band);border-top:1px solid var(--line)}
.press-grid{display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:center}
.press h2{font-size:34px}
.press p{color:var(--muted)}
.press figure{margin:0;background:var(--paper);padding:12px;box-shadow:0 12px 28px rgba(42,35,24,.09)}
.press img{display:block;width:100%;height:auto}
.bottom{padding:56px 0;background:#242528;color:#fff}
.bottom-inner{display:flex;justify-content:space-between;gap:30px;align-items:center}
.bottom h2{font-size:34px}
.bottom p{color:#c9c7c0;max-width:520px}
footer{padding:30px 0;color:var(--muted);font-size:12px}
@media(max-width:800px){
  .wrap{width:min(100% - 28px,1120px)}
  .nav{height:auto;min-height:64px;flex-wrap:wrap;padding:12px 0}
  nav{gap:12px;flex-wrap:wrap;justify-content:flex-end}
  .hero{padding:60px 0}
  .project-head,.press-grid{grid-template-columns:1fr;gap:20px}
  .gallery{grid-template-columns:repeat(2,1fr)}
  .photo:first-child{grid-column:span 2;grid-row:auto}
  .photo img,.photo:first-child img{height:220px}
  .bottom-inner{flex-direction:column;align-items:flex-start}
}
@media(max-width:480px){
  nav a:not(.cta){display:none}
  .gallery{grid-template-columns:1fr}
  .photo:first-child{grid-column:span 1}
  .photo img,.photo:first-child img{height:240px}
  h1{font-size:42px}
}
</style>
</head>
